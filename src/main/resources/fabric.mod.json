			"com.fabricaccweckseln.MCFabricAccWeckseln"
		],
		"client": [
			"com.fabricaccweckseln.client.MCFabricAccWeckselnClient"
		]
	},
	"mixins": [
		"mcfabricaccweckseln.mixins.json",
