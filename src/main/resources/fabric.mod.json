{
	"schemaVersion": 1,
	"id": "mcfabricaccweckseln",
	"version": "${version}",
	"name": "MCFabricAccWeckseln",
	"description": "Client-side Microsoft account switcher for Fabric.",
	"authors": [
		"FabricAccWeckseln"
	],
	"contact": {
		"homepage": "https://example.com",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/mcfabricaccweckseln/icon.png",
